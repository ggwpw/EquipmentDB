<Application x:Class="EquipmentDB.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EquipmentDB.ViewModels"
             xmlns:pages="clr-namespace:EquipmentDB.Views.Pages">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type vm:EquipmentViewModel}">
                <pages:EquipmentPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RoomsViewModel}">
                <pages:RoomsPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UsersViewModel}">
                <pages:UsersPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:EventLogViewModel}">
                <pages:EventLogPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                <pages:ReportsPage/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
