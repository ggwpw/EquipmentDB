<Window x:Class="EquipmentDB.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EquipmentDB.ViewModels"
        Title="Вход в систему" Height="520" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">
    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>
    <Grid>
        <StackPanel VerticalAlignment="Center" Margin="48,0">

            <!-- Header -->
            <Border Background="{StaticResource PrimaryBrush}" CornerRadius="10"
                    Padding="24,20" Margin="0,0,0,28">
                <StackPanel>
                    <TextBlock Text="&#x1F5A5;" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Учёт оборудования" FontFamily="Segoe UI" FontSize="16"
                               FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="компьютерных классов" FontFamily="Segoe UI" FontSize="13"
                               Foreground="#A8C4E8" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Login -->
            <TextBlock Text="Логин" Style="{StaticResource FormLabel}"/>
            <TextBox x:Name="LoginBox"
                     Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnKeyDown"/>

            <!-- Password -->
            <TextBlock Text="Пароль" Style="{StaticResource FormLabel}"/>
            <PasswordBox x:Name="PwdBox" KeyDown="OnKeyDown"/>

            <!-- Error -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerBrush}"
                       FontFamily="Segoe UI" FontSize="12"
                       Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}"/>

            <!-- Attempts remaining -->
            <TextBlock Text="{Binding AttemptsMessage}"
                       Foreground="#E67E22"
                       FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                       Margin="0,4,0,0"
                       Visibility="{Binding AttemptsMessage, Converter={StaticResource NullToVis}}"/>

            <!-- Login button -->
            <Button Content="Войти" Style="{StaticResource BtnPrimary}"
                    Margin="0,16,0,0" Height="40" FontSize="14"
                    Command="{Binding LoginCommand}"
                    Click="OnLoginClick"/>

            <!-- DEV: Reset button -->
            <Border Margin="0,16,0,0" BorderBrush="#FFD700" BorderThickness="1"
                    CornerRadius="5" Background="#FFFDE7">
                <Button Content="&#x1F527; DEV: Сбросить пароли и блокировки"
                        Command="{Binding DevResetCommand}"
                        FontFamily="Segoe UI" FontSize="11"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#7B5800" Padding="8,6" Cursor="Hand"/>
            </Border>

            <TextBlock Text="© Галкин Владислав, ИСиП3/1" FontFamily="Segoe UI" FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</Window>
