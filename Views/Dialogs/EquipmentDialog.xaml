<Window x:Class="EquipmentDB.Views.Dialogs.EquipmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оборудование" Height="560" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Closing="OnWindowClosing"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" BorderThickness="0" Background="Transparent">

            <TabItem Header="Основное">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Инвентарный номер *" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding InventoryNumber, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Название *" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Тип оборудования *" Style="{StaticResource FormLabel}"/>
                        <ComboBox ItemsSource="{Binding Types}" DisplayMemberPath="Name"
                                  SelectedValuePath="Id" SelectedValue="{Binding TypeId}"/>
                        <TextBlock Text="Класс *" Style="{StaticResource FormLabel}"/>
                        <ComboBox ItemsSource="{Binding Rooms}" DisplayMemberPath="Name"
                                  SelectedValuePath="Id" SelectedValue="{Binding RoomId}"/>
                        <TextBlock Text="Состояние *" Style="{StaticResource FormLabel}"/>
                        <ComboBox ItemsSource="{Binding Statuses}" DisplayMemberPath="Name"
                                  SelectedValuePath="Id" SelectedValue="{Binding StatusId}"/>
                        <TextBlock Text="Дата поступления *" Style="{StaticResource FormLabel}"/>
                        <DatePicker SelectedDate="{Binding ArrivalDateDt}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Характеристики">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Технические характеристики" Style="{StaticResource FormLabel}"/>
                    <TextBox Text="{Binding Specs, UpdateSourceTrigger=PropertyChanged}"
                             Height="220" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Фото">
                <StackPanel Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Выбрать файл" Style="{StaticResource BtnPrimary}"
                                Click="OnBrowsePhoto" Margin="0,0,8,0"/>
                        <Button Content="Удалить фото" Style="{StaticResource BtnDanger}"
                                Click="OnRemovePhoto"/>
                    </StackPanel>
                    <TextBlock Text="{Binding PhotoFileName}" FontFamily="Segoe UI" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,8"
                               ToolTip="{Binding PhotoPath}"/>
                    <Border Height="230" BorderBrush="{StaticResource BorderBrush2}"
                            BorderThickness="1" CornerRadius="6" Background="{StaticResource SurfaceBrush}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding PhotoPath, Converter={StaticResource InvNullToVis}}">
                                <TextBlock Text="&#x1F5BC;" FontSize="40" HorizontalAlignment="Center"/>
                                <TextBlock Text="Фото не выбрано" FontFamily="Segoe UI" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Image x:Name="PhotoPreview" Stretch="Uniform" Margin="8"
                                   Visibility="{Binding PhotoPath, Converter={StaticResource NullToVis}}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена"    Style="{StaticResource BtnSecondary}" Width="90"  Margin="0,0,8,0" Click="OnCancel"/>
            <Button Content="Сохранить" Style="{StaticResource BtnPrimary}"   Width="100" Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>
