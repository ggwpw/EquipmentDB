<Window x:Class="EquipmentDB.Views.Dialogs.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сброс пароля" Height="260" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Новый пароль *" Style="{StaticResource FormLabel}"/>
            <PasswordBox x:Name="PwdBox"/>
            <TextBlock Text="Подтверждение пароля *" Style="{StaticResource FormLabel}"/>
            <PasswordBox x:Name="ConfirmBox"/>
            <TextBlock Text="Минимум 4 символа." FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена"    Style="{StaticResource BtnSecondary}" Width="90"  Margin="0,0,8,0" Click="OnCancel"/>
            <Button Content="Сохранить" Style="{StaticResource BtnPrimary}"   Width="100" Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>