<Window x:Class="EquipmentDB.Views.Dialogs.RoomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Класс" Height="310" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Номер кабинета *" Style="{StaticResource FormLabel}"/>
            <TextBox Text="{Binding Cabinet, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Название класса *" Style="{StaticResource FormLabel}"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Вместимость (мест)" Style="{StaticResource FormLabel}"/>
            <TextBox x:Name="CapacityBox" Text="{Binding Capacity, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена"    Style="{StaticResource BtnSecondary}" Width="90"  Margin="0,0,8,0" Click="OnCancel"/>
            <Button Content="Сохранить" Style="{StaticResource BtnPrimary}"   Width="100" Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>