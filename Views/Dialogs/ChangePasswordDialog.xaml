<Window x:Class="EquipmentDB.Views.Dialogs.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена пароля" Height="300" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Текущий пароль *" Style="{StaticResource FormLabel}"/>
            <PasswordBox x:Name="CurrentBox"/>
            <TextBlock Text="Новый пароль * (мин. 6 символов)" Style="{StaticResource FormLabel}"/>
            <PasswordBox x:Name="NewBox"/>
            <TextBlock Text="Подтверждение нового пароля *" Style="{StaticResource FormLabel}"/>
            <PasswordBox x:Name="ConfirmBox"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена"    Style="{StaticResource BtnSecondary}" Width="90" Margin="0,0,8,0" Click="OnCancel"/>
            <Button Content="Сохранить" Style="{StaticResource BtnPrimary}"   Width="100" Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>
