<Window x:Class="EquipmentDB.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EquipmentDB.ViewModels"
        Title="Учёт оборудования" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen" MinHeight="600" MinWidth="900"
        Background="{StaticResource SurfaceBrush}">
    <Window.DataContext><vm:MainViewModel/></Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource PrimaryBrush}" Grid.Column="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,20,16,16" BorderBrush="#1A2E4A" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="&#x1F5A5; Учёт оборудования" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                        <TextBlock Text="компьютерных классов" FontFamily="Segoe UI" FontSize="11" Foreground="#7BA3CC"/>
                    </StackPanel>
                </Border>
                <Border DockPanel.Dock="Bottom" Padding="16,12" BorderBrush="#1A2E4A" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding UserLogin}" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="{Binding UserRoleDisplay}" FontFamily="Segoe UI" FontSize="11" Foreground="#7BA3CC" Margin="0,2,0,8"/>
                        <Button Content="Выйти" Style="{StaticResource BtnNav}" Foreground="#E87C7C" Command="{Binding LogoutCommand}" HorizontalAlignment="Left" Padding="0,4"/>
                    </StackPanel>
                </Border>
                <StackPanel Margin="0,12,0,0">
                    <Button Content="&#x1F4E6;  Оборудование"        Style="{StaticResource BtnNav}" Command="{Binding NavEquipmentCommand}"/>
                    <Button Content="&#x1F3EB;  Классы и сотрудники" Style="{StaticResource BtnNav}" Command="{Binding NavRoomsCommand}"/>
                    <Button Content="&#x1F464;  Пользователи"        Style="{StaticResource BtnNav}" Command="{Binding NavUsersCommand}"     Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="&#x1F4CB;  Журнал событий"      Style="{StaticResource BtnNav}" Command="{Binding NavEventLogCommand}"  Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="&#x1F4CA;  Отчёты"              Style="{StaticResource BtnNav}" Command="{Binding NavReportsCommand}"/>
                    <Button Content="&#x1F5C4;  Редактор БД"         Style="{StaticResource BtnNav}" Command="{Binding NavDbEditorCommand}"  Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="24,14">
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" Margin="0"/>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
        </Grid>
    </Grid>
</Window>