<UserControl x:Class="EquipmentDB.Views.Pages.EventLogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="С:" VerticalAlignment="Center" Margin="0,0,6,0" FontFamily="Segoe UI" FontSize="13"/>
                <DatePicker SelectedDate="{Binding From}" Width="130" Margin="0,0,12,0"/>
                <TextBlock Text="По:" VerticalAlignment="Center" Margin="0,0,6,0" FontFamily="Segoe UI" FontSize="13"/>
                <DatePicker SelectedDate="{Binding To}" Width="130" Margin="0,0,12,0"/>
                <TextBox Text="{Binding SearchUser, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,8,0" ToolTip="Поиск по логину"/>
                <Button Content="&#x1F504; Обновить" Style="{StaticResource BtnSecondary}" Command="{Binding RefreshCommand}"/>
            </WrapPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Entries}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Время"        Binding="{Binding EventTime, StringFormat=dd.MM.yyyy HH:mm:ss}" Width="145"/>
                    <DataGridTextColumn Header="Компьютер"    Binding="{Binding MachineName}"  Width="110"/>
                    <DataGridTextColumn Header="Пользователь" Binding="{Binding User.Login}"   Width="100"/>
                    <DataGridTextColumn Header="Событие"      Binding="{Binding EventType}"    Width="120"/>
                    <DataGridTextColumn Header="Описание"     Binding="{Binding Description}"  Width="*"/>
                    <DataGridTextColumn Header="Таблица"      Binding="{Binding TableName}"    Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>