<UserControl x:Class="EquipmentDB.Views.Pages.UsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16">
            <WrapPanel>
                <Button Content="+ Добавить"           Style="{StaticResource BtnPrimary}"   Command="{Binding AddCommand}"      Margin="0,0,6,0"/>
                <Button Content="&#x270F; Изменить"    Style="{StaticResource BtnSecondary}" Command="{Binding EditCommand}"     Margin="0,0,6,0"/>
                <Button Content="&#x1F512; Блок/Разблок" Style="{StaticResource BtnSecondary}" Command="{Binding ToggleCommand}" Margin="0,0,6,0"/>
                <Button Content="&#x1F511; Сбросить пароль" Style="{StaticResource BtnSecondary}" Command="{Binding ResetPwdCommand}"/>
            </WrapPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding Selected}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Логин"     Binding="{Binding Login}"                                       Width="120"/>
                    <DataGridTextColumn Header="Роль"      Binding="{Binding Role, Converter={StaticResource RoleConv}}"   Width="130"/>
                    <DataGridTextColumn Header="Сотрудник" Binding="{Binding Staff.FullName}"                              Width="*"/>
                    <DataGridTemplateColumn Header="Статус" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IsActive, Converter={StaticResource ActiveConv}}"
                                           Foreground="{Binding IsActive, Converter={StaticResource ActiveBrush}}"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Создан"   Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" Width="100"/>
                    <DataGridTextColumn Header="Попыток"  Binding="{Binding FailedAttempts}"                     Width="75"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>