<UserControl x:Class="EquipmentDB.Views.Pages.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16">
            <WrapPanel>
                <ComboBox ItemsSource="{Binding Reports}" SelectedIndex="{Binding SelectedReport}"
                          DisplayMemberPath="Name" Width="300" Margin="0,0,12,0"/>
                <Button Content="🔄 Обновить"    Style="{StaticResource BtnSecondary}"
                        Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                <Button Content="📥 Экспорт в Excel" Style="{StaticResource BtnPrimary}"
                        Command="{Binding ExportCommand}"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Заголовок отчёта -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1"
                        Padding="16,10">
                    <TextBlock Text="{Binding ReportTitle}" FontFamily="Segoe UI" FontSize="15"
                               FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                </Border>
                <!-- Диаграмма (только для отчёта "Аналитика по типам") -->
                <Border Grid.Row="1" Padding="16,12"
                        Visibility="{Binding IsChartVisible, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding ChartBars}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="35"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontFamily="Segoe UI" FontSize="12"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" Height="20" CornerRadius="3" Margin="4,0"
                                            Background="{Binding Color}" Width="{Binding BarWidth}"
                                            HorizontalAlignment="Left" ToolTip="{Binding Value}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Value}" FontFamily="Segoe UI" FontSize="12"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <!-- Таблица данных -->
                <DataGrid Grid.Row="2" ItemsSource="{Binding ReportData}"
                          AutoGenerateColumns="True" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
