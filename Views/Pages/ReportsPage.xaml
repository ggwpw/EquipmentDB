<UserControl x:Class="EquipmentDB.Views.Pages.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16">
            <WrapPanel>
                <ComboBox ItemsSource="{Binding Reports}" SelectedIndex="{Binding SelectedReport}" DisplayMemberPath="Name" Width="300" Margin="0,0,12,0"/>
                <Button Content="&#x1F504; Обновить" Style="{StaticResource BtnPrimary}" Command="{Binding RefreshCommand}"/>
            </WrapPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding ReportTitle}" FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}" Margin="16,12,16,8"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding ReportData}" AutoGenerateColumns="True"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>