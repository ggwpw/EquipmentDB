<UserControl x:Class="EquipmentDB.Views.Pages.EquipmentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16">
            <WrapPanel>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,8,0" ToolTip="Поиск по названию или инв. номеру"/>
                <ComboBox ItemsSource="{Binding Rooms}" SelectedValuePath="Id" SelectedValue="{Binding FilterRoomId}" DisplayMemberPath="Name" Width="160" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding Statuses}" SelectedValuePath="Id" SelectedValue="{Binding FilterStatusId}" DisplayMemberPath="Name" Width="130" Margin="0,0,8,0"/>
                <Button Content="Сбросить" Style="{StaticResource BtnSecondary}" Command="{Binding ClearFiltersCommand}" Margin="0,0,16,0"/>
                <Button Content="+ Добавить" Style="{StaticResource BtnPrimary}" Command="{Binding AddCommand}" Margin="0,0,6,0" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
                <Button Content="&#x270F; Изменить" Style="{StaticResource BtnSecondary}" Command="{Binding EditCommand}" Margin="0,0,6,0" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
                <Button Content="&#x1F5D1; Удалить" Style="{StaticResource BtnDanger}" Command="{Binding DeleteCommand}" Margin="0,0,6,0" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
                <Button Content="&#x1F4E5; Excel" Style="{StaticResource BtnSecondary}" Command="{Binding ExportCommand}"/>
            </WrapPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Инв. номер"      Binding="{Binding InventoryNumber}" Width="120"/>
                    <DataGridTextColumn Header="Название"        Binding="{Binding Name}"            Width="*"/>
                    <DataGridTextColumn Header="Тип"             Binding="{Binding Type.Name}"       Width="140"/>
                    <DataGridTextColumn Header="Класс"           Binding="{Binding Room.Cabinet}"    Width="70"/>
                    <DataGridTemplateColumn Header="Состояние"   Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                             Fill="{Binding Status.ColorHex, Converter={StaticResource HexToBrush}}"/>
                                    <TextBlock Text="{Binding Status.Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Дата поступления" Binding="{Binding ArrivalDate}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>