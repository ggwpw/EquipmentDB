<UserControl x:Class="EquipmentDB.Views.Pages.EquipmentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:EquipmentDB.Helpers"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16">
            <WrapPanel>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,12,0" ToolTip="Поиск по названию или инв. номеру"/>
                <!-- Фильтр по классу -->
                <Grid Width="170" Margin="0,0,10,0">
                    <ComboBox ItemsSource="{Binding Rooms}" SelectedValuePath="Id" SelectedValue="{Binding FilterRoomId}" DisplayMemberPath="Name"/>
                    <TextBlock Text="— Компьютерный класс —" IsHitTestVisible="False" VerticalAlignment="Center" Margin="8,0,26,0"
                               FontStyle="Italic" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               Visibility="{Binding FilterRoomId, Converter={StaticResource NullToVisInv}}"/>
                </Grid>
                <!-- Фильтр по статусу -->
                <Grid Width="140" Margin="0,0,10,0">
                    <ComboBox ItemsSource="{Binding Statuses}" SelectedValuePath="Id" SelectedValue="{Binding FilterStatusId}" DisplayMemberPath="Name"/>
                    <TextBlock Text="— Состояние —" IsHitTestVisible="False" VerticalAlignment="Center" Margin="8,0,26,0"
                               FontStyle="Italic" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               Visibility="{Binding FilterStatusId, Converter={StaticResource NullToVisInv}}"/>
                </Grid>
                <Button Content="Сбросить" Style="{StaticResource BtnSecondary}" Command="{Binding ClearFiltersCommand}" Margin="0,0,16,0"/>
                <Button Content="+ Добавить" Style="{StaticResource BtnPrimary}" Command="{Binding AddCommand}" Margin="0,0,6,0" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Изменить" Style="{StaticResource BtnSecondary}" Command="{Binding EditCommand}" Margin="0,0,6,0" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Удалить" Style="{StaticResource BtnDanger}" Command="{Binding DeleteCommand}" Margin="0,0,6,0" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
                <Button Content="&#x1F4E5; Excel" Style="{StaticResource BtnSecondary}" Command="{Binding ExportCommand}"/>
            </WrapPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Таблица оборудования -->
                <DataGrid Grid.Column="0" helpers:DataGridHelper.EnableCopyRow="True"
                          ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Инв. номер"      Binding="{Binding InventoryNumber}" Width="120"/>
                        <DataGridTextColumn Header="Название"        Binding="{Binding Name}"            Width="*"/>
                        <DataGridTextColumn Header="Тип"             Binding="{Binding Type.Name}"       Width="140"/>
                        <DataGridTextColumn Header="Класс"           Binding="{Binding Room.Cabinet}"    Width="70"/>
                        <DataGridTemplateColumn Header="Состояние"   Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                                 Fill="{Binding Status.ColorHex, Converter={StaticResource HexToBrush}}"/>
                                        <TextBlock Text="{Binding Status.Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Дата поступления" Binding="{Binding ArrivalDate}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
                <!-- Панель превью фото справа (только когда выбрана строка) -->
                <Border Grid.Column="1" Width="190"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1,0,0,0"
                        Visibility="{Binding Selected, Converter={StaticResource NullToVis}}">
                    <StackPanel Margin="12" VerticalAlignment="Top">
                        <TextBlock Text="ФОТО" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,8"/>
                        <Border CornerRadius="6" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                Background="{StaticResource SurfaceBrush}">
                            <Grid MinHeight="80">
                                <Image Source="{Binding Selected.PhotoPath, Converter={StaticResource PathToImage}}"
                                       Stretch="Uniform" MaxHeight="170" MaxWidth="166" Margin="4"
                                       Visibility="{Binding Selected.PhotoPath, Converter={StaticResource NullToVis}}"/>
                                <TextBlock Text="Нет фото" VerticalAlignment="Center" HorizontalAlignment="Center"
                                           FontFamily="Segoe UI" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                           Visibility="{Binding Selected.PhotoPath, Converter={StaticResource NullToVisInv}}"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Selected.Name}" FontFamily="Segoe UI" FontSize="11"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextAlignment="Center"
                                   Margin="0,8,0,2" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Selected.InventoryNumber}" FontFamily="Segoe UI" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>