<UserControl x:Class="EquipmentDB.Views.Pages.RoomsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Классы" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="+ Добавить" Style="{StaticResource BtnPrimary}" Margin="0,0,6,0" Command="{Binding AddRoomCommand}" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
                <Button Content="&#x270F;" Style="{StaticResource BtnSecondary}" Width="34" Margin="0,0,6,0" Command="{Binding EditRoomCommand}" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
                <Button Content="&#x1F5D1;" Style="{StaticResource BtnDanger}" Width="34" Command="{Binding DeleteRoomCommand}" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <DataGrid ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Кабинет"     Binding="{Binding Cabinet}"  Width="80"/>
                        <DataGridTextColumn Header="Название"    Binding="{Binding Name}"     Width="*"/>
                        <DataGridTextColumn Header="Вместимость" Binding="{Binding Capacity}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Сотрудники" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="+ Добавить" Style="{StaticResource BtnPrimary}" Margin="0,0,6,0" Command="{Binding AddStaffCommand}" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
                <Button Content="&#x270F;" Style="{StaticResource BtnSecondary}" Width="34" Margin="0,0,6,0" Command="{Binding EditStaffCommand}" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
                <Button Content="&#x1F5D1;" Style="{StaticResource BtnDanger}" Width="34" Command="{Binding DeleteStaffCommand}" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <DataGrid ItemsSource="{Binding Staff}" SelectedItem="{Binding SelectedStaff}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ФИО"       Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="140"/>
                        <DataGridTextColumn Header="Телефон"   Binding="{Binding Phone}"    Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>