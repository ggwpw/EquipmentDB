<UserControl x:Class="EquipmentDB.Views.Pages.DatabaseEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Таблица:" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="13"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding Tables}"
                          SelectedValue="{Binding SelectedTable}" SelectedValuePath="SqlName"
                          DisplayMemberPath="DisplayName"
                          Width="220" Margin="0,0,16,0"/>
                <Button Content="&#x1F504; Обновить" Style="{StaticResource BtnSecondary}"
                        Command="{Binding RefreshCommand}" Margin="0,0,6,0"/>
                <Button Content="&#x1F4BE; Сохранить изменения" Style="{StaticResource BtnPrimary}"
                        Command="{Binding SaveCommand}" Margin="0,0,6,0"/>
                <Button Content="✖ Отменить" Style="{StaticResource BtnSecondary}"
                        Command="{Binding DiscardCommand}"/>
                <!-- Dirty indicator -->
                <TextBlock Text="● Есть несохранённые изменения" VerticalAlignment="Center"
                           Margin="16,0,0,0" FontFamily="Segoe UI" FontSize="12" FontStyle="Italic"
                           Foreground="#E67E22"
                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"/>
                <!-- Busy indicator -->
                <TextBlock Text="Загрузка…" VerticalAlignment="Center" Margin="12,0,0,0"
                           FontFamily="Segoe UI" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </WrapPanel>
        </Border>

        <!-- Table content -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <!-- Placeholder when no table is selected -->
                <TextBlock Text="Выберите таблицу из списка выше для просмотра и редактирования"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource TextMutedBrush}"
                           Visibility="{Binding TableData, Converter={StaticResource NullToVisInv}}"/>
                <!-- DataGrid -->
                <DataGrid ItemsSource="{Binding TableData}"
                          AutoGenerateColumns="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="True"
                          IsReadOnly="False"
                          Visibility="{Binding TableData, Converter={StaticResource NullToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
